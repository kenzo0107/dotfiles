[core]
  excludesfile = ~/.gitignore_global
  editor = vim
  quotepath = false
  commitGraph = true
	pager = less -X
[protocol]
  version = 2
[user]
  name = Kenzo Tanaka
  email = kenzo.tanaka0107@gmail.com
  signingkey = 7062AF5B7AB0970A
[commit]
  gpgsign = true
  cleanup = scissors
[tag]
  gpgSign = true
[fetch]
  prune = true
[mergetool]
  keepBackup = false
[push]
  default = current
[rebase]
  autosquash = true
  autoStash = true
[status]
  branch = true
[include]
  path = ~/.gitconfig_private
[diff]
	noprefix = true
[init]
	defaultBranch = main
[difftool "sourcetree"]
	cmd = opendiff \"$LOCAL\" \"$REMOTE\"
	path = 
[credential]
	helper = osxkeychain
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
	helper = osxkeychain
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
