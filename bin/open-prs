#!/usr/bin/env bash
set -euo pipefail

AUTHOR="mpg-kenzo-tanaka"
OWNER="medpeer-dev"
EXCLUDE_DRAFT=false

usage() {
  echo "usage: $(basename "$0") [--no-draft]" >&2
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --no-draft) EXCLUDE_DRAFT=true ;;
    -h|--help) usage; exit 0 ;;
    *) usage; exit 1 ;;
  esac
  shift
done

RESULT=$(gh search prs \
  --author="${AUTHOR}" \
  --owner="${OWNER}" \
  --state=open \
  --limit=200 \
  --json title,url,repository,isDraft \
  --jq "
    map(select(${EXCLUDE_DRAFT} | not or (.isDraft | not))) |
    group_by(.repository.name)[] |
    \"- \" + .[0].repository.name + \"\n\" +
    (map(\"    - \" + (if .isDraft then \"[draft] \" else \"\" end) + \"[\" + .title + \"](\" + .url + \")\") | join(\"\n\"))
  ")

if [[ -z "${RESULT}" ]]; then
  echo "open な PR はありません" >&2
  exit 0
fi

echo "## open な PR"
echo ""
echo "${RESULT}"
